{
  "name": "simple-express-api",
  "version": "1.0.0",
  "description": "Simple Express API with CRUD endpoints",
  "main": "dist/server.js",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "NODE_ENV=localDevelopment nodemon src/server.ts",
    "dev:local": "NODE_ENV=localDevelopment nodemon src/server.ts",
    "dev:prod": "NODE_ENV=production nodemon src/server.ts",
    "build": "tsc",
    "build:local": "NODE_ENV=localDevelopment tsc",
    "build:prod": "NODE_ENV=production tsc",
    "watch": "tsc -w"
  },
  "dependencies": {
    "@types/config": "^3.3.0",
    "config": "^3.3.9",
    "cors": "^2.8.5",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/node": "^20.5.0",
    "nodemon": "^3.0.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.1.6"
  },
  "keywords": [
    "express",
    "api",
    "crud",
    "typescript"
  ],
  "author": "",
  "license": "MIT"
}
